    invoice = Invoice(**payload.model_dump())
    db.add(invoice)
    db.commit()
    db.refresh(invoice)
    return invoice


@app.post("/api/ai/assistant")
def ai_assistant(payload: AIRequest, db: Annotated[Session, Depends(get_db)]):
    summary = db.query(func.coalesce(func.sum(Sale.total_amount), 0)).scalar() or 0
    total_clients = db.query(Client).count()
    sales_count = db.query(Sale).count()
    low_stock = db.query(Product).filter(Product.stock_quantity <= Product.low_stock_threshold).count()

    response = generate_business_intelligence(
        payload.message,
        {
            "monthly_revenue": float(summary),
            "total_clients": total_clients,
            "sales_count": sales_count,
            "low_stock": low_stock,
        },
    )
    return response


@app.get("/api/users", response_model=list[UserOut])
def list_users(db: Annotated[Session, Depends(get_db)]):
    return db.query(User).order_by(User.id.asc()).all()
