@app.get("/api/sales", response_model=list[SaleOut])
def list_sales(db: Annotated[Session, Depends(get_db)]):
    return db.query(Sale).order_by(Sale.sale_date.desc()).all()


@app.post("/api/sales", response_model=SaleOut)
def create_sale(payload: SaleCreate, db: Annotated[Session, Depends(get_db)]):
    product = db.query(Product).filter(Product.id == payload.product_id).first()
    if not product:
        raise HTTPException(status_code=404, detail="Produit introuvable")
    sale = Sale(
        client_id=payload.client_id,
        product_id=payload.product_id,
        quantity=payload.quantity,
        unit_price=payload.unit_price or product.unit_price,
        total_amount=payload.total_amount or (payload.quantity * (payload.unit_price or product.unit_price)),
        status=payload.status,
    )
    product.stock_quantity = max(0, product.stock_quantity - payload.quantity)
    db.add(sale)
    db.commit()
    db.refresh(sale)
    return sale


